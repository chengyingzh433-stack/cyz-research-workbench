{
  "name": "cyz-research-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "CYZ 本地教育研究工作台",
  "author": "CYZ",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "probe:codex": "node scripts/probe-codex.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e --workers=1",
    "build": "node scripts/build.mjs",
    "start": "electron dist/main.cjs",
    "prepare:installer": "py -3.11 scripts/prepare-installer.py",
    "dist:win": "pnpm build && pnpm prepare:installer && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
